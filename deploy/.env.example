# Copy to deploy/.env (never committed) and fill in every value. docs/tu-chay.md explains each one.
DB_PASSWORD=
STORE_USER=
STORE_PASSWORD=
# The address guests and owners type, e.g. https://quitesensational-review-bio.com (http://127.0.0.1:3000 on this machine only)
APP_ORIGIN=http://127.0.0.1:3000
# Two secrets of at least 32 characters each: openssl rand -hex 32
NFC_RENDER_SIGNING_KEY=
NFC_TOTP_KEY=
# Where the owner's browser reaches the store, and where guests read pictures from it
STORAGE_ENDPOINT=http://127.0.0.1:9000
MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:9000/nfc-media
# Behind nginx/Caddy that sets X-Real-IP: x-real-ip. Empty: no counting by address.
NFC_CLIENT_IP_HEADER=
NFC_SUPPORT_CONTACT=
