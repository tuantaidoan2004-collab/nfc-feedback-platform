# Copy to deploy/hosted/hosted.env (never committed) with the values Vercel's Production has today. Fastest, on the VPS:
#   vercel env pull deploy/hosted/hosted.env --environment=production
# then delete every line that starts with VERCEL_ or TURBO_ (Vercel's own), and NFC_BUILD_TARGET.
