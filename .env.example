# Deployment must declare its environment. Unset or unrecognised keeps owner, visit and publishing routes
# closed no matter what the feature flags below say. Values: local | preview | production.
NFC_ENV=

# Server storage is opt-in. Use a separate development PostgreSQL database.
SERVER_DATA_ENABLED=false
DATABASE_URL=
# Optional. Only needed when DATABASE_URL points at a transaction-mode pooler: owner export streams a
# server-side cursor and needs a session-mode connection to the same database. Unset means reuse DATABASE_URL.
# DATABASE_URL_UNPOOLED is also accepted, since managed providers often publish that name themselves.
DATABASE_URL_DIRECT=
APP_ORIGIN=http://127.0.0.1:3000
# Public HTTPS media domain backed by R2 (the bucket's r2.dev URL for now). Never put R2 credentials in NEXT_PUBLIC_*.
MEDIA_PUBLIC_ORIGIN=
# Direct uploads from the page editor. All five (with MEDIA_PUBLIC_ORIGIN) or uploads stay off. Token scoped to one
# bucket with Object Read & Write. See docs/r2-uploads.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Feature flags. Each still requires NFC_ENV above to be declared.
NFC_VISITS_V2_ENABLED=false
NFC_OWNER_V2_ENABLED=false
# Platform administration at /gov. Separate from the owner flag on purpose.
NFC_ADMIN_ENABLED=false
NFC_PUBLISHING_ENABLED=false
# At least 32 bytes. Required when publishing is enabled. Never commit a real value.
NFC_RENDER_SIGNING_KEY=

# Build target. Default standalone for self-hosting; set to "vercel" on platforms that provide their own server.
NFC_BUILD_TARGET=standalone
