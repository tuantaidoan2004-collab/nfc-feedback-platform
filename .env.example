# Sao chép thành .env rồi điền. Ở production (NODE_ENV=production) hệ thống từ chối chạy nếu thiếu mục bắt buộc.

NODE_ENV=production
PORT=3000
# Chỉ nghe trong máy (bắt buộc khi chạy trên Mac qua Cloudflare Tunnel). Để trống = mọi địa chỉ.
HOST=127.0.0.1
# Địa chỉ công khai (https), có thể kèm 1 thư mục: TBQ chạy ở thu.tiembanquyen.com/colap. Mọi trang, link, cookie tự đi theo thư mục này.
# Nút trên trang quán của QS mở BASE_URL/qs/<mã quán QS>?t=<vé> (xem docs/phoi-hop-voi-QS.md).
BASE_URL=https://thu.tiembanquyen.com/colap
DB_PATH=./data/tbq.sqlite
# IP thật của khách (cho giới hạn chống spam OTP / IP / giờ). Chạy sau Caddy: Caddyfile có `header_up X-Real-IP {remote_host}`
# và đặt CLIENT_IP_HEADER=x-real-ip. Sau Cloudflare Tunnel: cf-connecting-ip.
# KHÔNG đặt header mà proxy không ghi đè: khách tự đổi IP trong header là lách được giới hạn.
CLIENT_IP_HEADER=x-real-ip

# Khoá ký vé dùng chung với trang quán QS — PHẢI giống hệt NFC_EVENT_TBQ_KEY bên QS (Tài đặt). >= 32 ký tự.
# Vé chứng minh khách vừa chạm thẻ / quét QR trên bàn (đang ở quán). Thiếu / sai khoá thì không khách nào nhận được.
# Tạo 1 lần: openssl rand -hex 32 — gửi Tài qua kênh riêng, không dán vào nhóm chat.
QS_TICKET_KEY=
# API kho cho QS (Tài thêm / sửa / xem tài khoản): khoá riêng, khác QS_TICKET_KEY. Trống = tắt. openssl rand -hex 32
QS_KHO_KEY=
# Trang quán QS (Tài) — Tiệm đọc tên quán từ đây khi chủ chỉ dán link quán. Để trống = quitesensational-review-bio.com
QS_ORIGIN=

# Bot Canva (npm run canva-bot) trên máy Mac của Tiệm: mời / gỡ khách khỏi nhóm Canva. Tạo: openssl rand -base64 32
# Máy chủ TBQ và máy chạy bot đều đặt cùng WORKER_TOKEN; máy chạy bot thêm TBQ_URL=https://thu.tiembanquyen.com/colap
WORKER_TOKEN=
# TBQ_URL=

# Bí mật ứng dụng (>= 24 ký tự). Tạo: openssl rand -base64 32
APP_SECRET=
# Khoá mã hoá mật khẩu tài khoản trong kho: đúng 32 byte base64. Tạo: openssl rand -base64 32
# MẤT KHOÁ NÀY = mất toàn bộ mật khẩu đã lưu. Sao lưu ở nơi an toàn, KHÔNG để chung với file database.
DATA_KEY=
# Mật khẩu trang /admin (>= 12 ký tự)
ADMIN_PASSWORD=
# Email / SĐT chủ tiệm dùng để thử (cách nhau dấu phẩy): luôn nhận được tài khoản mới — bỏ qua hạn mức, khoá, rủi ro.
# Vẫn phải chạm thẻ ở quán và kho còn hàng. Để trống = tắt.
OWNER_IDS=

# Thư mã của hãng: Cloudflare Email Worker (extras/cloudflare-email-worker.js) đẩy nguyên thư gốc về POST BASE_URL/hooks/mail,
# ký header X-Signature: sha256=<HMAC-SHA256(secret, nguyên body)>. Không nhận form, không nhận ?key=.
MAIL_WEBHOOK_SECRET=
# Kiểm thư mã về NHẦM hộp thư (tuỳ chọn, nên bật): tiembanquyen.site có luật catch-all → hộp thư ma.tiembanquyen.site của CapCut Tool.
# Địa chỉ kho thiếu quy tắc riêng → thư mã rơi sang đó, TBQ không nhận. TBQ hỏi hộp thư kia mỗi 10 phút (chỉ SỐ thư, không mã / nội dung)
# rồi báo đỏ trên Theo dõi. HUB_WATCH_TOKEN = watch_token trong tiembanquyen_mail/config.json (KHÔNG dùng token Admin của hộp thư).
HUB_WATCH_URL=
HUB_WATCH_TOKEN=
# HUB_WATCH_DOMAIN=tiembanquyen.site

# OTP — kênh gửi mã xác nhận cho khách:
#   email = khách nhập email, Tiệm gửi mã vào hộp thư (Cloudflare Email Sending). Khuyên dùng — không cần eSMS.
#   esms  = khách nhập SĐT, mã qua SMS eSMS.vn.   none = chưa mở nhận khách.   dev = chỉ chạy thử trên máy (in mã ra log).
OTP_PROVIDER=email
# Khách đăng nhập bằng email hay SĐT (để trống = theo OTP_PROVIDER).
LOGIN_BY=
# --- Gửi mã qua email (OTP_PROVIDER=email) ---
# Cần: tài khoản Cloudflare gói Workers Paid; tên miền của MAIL_FROM đã bật Email Sending (Cloudflare → Email Service → Email Sending → Onboard Domain);
# API token có quyền gửi thư (Email Sending: Edit). Thử: npm run otp-test -- ban@gmail.com
CF_ACCOUNT_ID=
CF_EMAIL_TOKEN=
MAIL_FROM=xacnhan@tiembanquyen.site
MAIL_FROM_NAME=Tiệm Bản Quyền
# --- SMS qua eSMS.vn (OTP_PROVIDER=esms) ---
# eSMS.vn: lấy ApiKey/SecretKey trong trang quản lý eSMS. Brandname CSKH: ESMS_SMS_TYPE=2 + ESMS_BRANDNAME.
# Đầu số cố định giá rẻ: ESMS_SMS_TYPE=8 (không cần brandname, nhưng phải đăng ký mẫu tin với eSMS).
# ESMS_TEMPLATE phải KHỚP mẫu đã đăng ký, không dấu, {code} là chỗ điền mã. Thử kết nối: npm run otp-test -- 09xxxxxxxx
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2
ESMS_TEMPLATE={code} la ma xac nhan cua ban tai Tiem Ban Quyen. Ma co hieu luc trong 5 phut.
# 1 = eSMS chỉ kiểm tra, không gửi tin thật (chỉ dùng với npm run otp-test; máy chủ production từ chối chạy khi bật)
ESMS_SANDBOX=0
# Tên kênh hiện cho khách ("Tiệm gửi mã qua ..."). Để trống = SMS.
OTP_CHANNEL_LABEL=
# Chỉ khi phát triển: hiện mã OTP ngay trên màn hình
OTP_DEV_SHOW=0

# Báo động, việc tay: không gửi đi đâu — mở trang quản trị BASE_URL/admin/live ("Theo dõi", tự làm mới, có âm báo) trên điện thoại.
